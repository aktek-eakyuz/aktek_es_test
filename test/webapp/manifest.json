{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.aktek.test",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.23.0",
      "toolsId": "e5d411b5-a272-4b8d-b6c7-61e47b02476b"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/aktek/es_ui_outgoing_o4/srvd/aktek/es_ui_outgoing/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.aktek.test.ext.controller.ListReporExt"
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.aktek.test.i18n.i18n",
          "supportedLocales": [
            "en",
            "tr",
            ""
          ],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "OutgoingList",
          "target": "OutgoingList"
        },
        {
          "pattern": "Outgoing({key}):?query:",
          "name": "OutgoingObjectPage",
          "target": "OutgoingObjectPage"
        }
      ],
      "targets": {
        "OutgoingList": {
          "type": "Component",
          "id": "OutgoingList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Outgoing",
              "variantManagement": "Page",
              "navigation": {
                "Outgoing": {
                  "detail": {
                    "route": "OutgoingObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "OutgoingListExtension": {
                      "press": "com.aktek.test.ext.controller.OutgoingListExtension.onSendAction",
                      "visible": true,
                      "enabled": "{buttonState>/sendEnabled}",
                      "requiresSelection": true,
                      "text": "{i18n>btnSend}"
                    },
                    "OutgoingList": {
                      "press": "com.aktek.test.ext.controller.OutgoingList.onDisplayXmlClicked",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Display XML"
                    }
                  }
                }
              }
            }
          }
        },
        "OutgoingObjectPage": {
          "type": "Component",
          "id": "OutgoingObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Outgoing",
              "content": {
                "header": {
                  "actions": {
                    "OutGoingListExtenSion": {
                      "press": "com.aktek.test.ext.controller.OutgoingListExtenSion.onSendAction",
                      "visible": true,
                      "enabled": "{= %{__OperationControl/send} === true }",
                      "requiresSelection": false,
                      "text": "{i18n>btnSend}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
